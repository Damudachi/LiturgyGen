# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.
# Every value here is a placeholder. Never commit a real connection string.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local:   postgresql://postgres:devpassword@localhost:5432/liturgygen
# Hosted:  postgresql://user:pass@host.neon.tech/liturgygen?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/liturgygen

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending error detail to your users.
NODE_ENV=development

# Do NOT set PORT locally or on a host. The host sets it for you.
# The desktop launcher sets it too, to a free port it picked.

# Bind address. Unset listens everywhere, which is what a host wants.
# The installed desktop app sets 127.0.0.1 so it listens on that machine only.
# HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Where the office's own data lives
# ---------------------------------------------------------------------------
# The installed app points this outside the program folder, so reinstalling or
# updating never touches the prayers and the saved readings. Unset, a
# development checkout uses server/data and server/.cache.
# LITURGYGEN_DATA_DIR=C:\Users\you\AppData\Local\LiturgyGen

# ---------------------------------------------------------------------------
# Readings sources
# ---------------------------------------------------------------------------
# USCCB blocks aggressive clients. Do not lower the delay or the cooldown
# without a reason: requests made while blocked renew the block.
USCCB_DELAY_MS=800
USCCB_TIMEOUT_MS=20000
USCCB_COOLDOWN_MS=180000

# Set to false to stop saving and reusing fetched readings. Readings for a past
# date never change, so leave this on.
USCCB_CACHE=true

# Particular liturgical calendar used by romcal.
ROMCAL_CALENDAR=philippines
