# Secrets. Never commit these. An .env that reached a public repository is not
# fixed by deleting the file: rotate the credential first, clean the history
# second.
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
dist/
build/

# Database dumps: a full plain-text copy of the office's data
*.dump
backup*.sql

# The SQLite database, while it is still the live one. It holds the office's
# own prayers and corrections.
server/data/*.sqlite
server/data/*.sqlite-journal
server/data/*.sqlite-wal
server/data/*.sqlite-shm

server/.cache/
output/

# Editor and OS noise
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*

# Copyrighted source material - transcriptions and scans of the office's own
# liturgical books (General Intercessions for Weekday Masses, Fr. Albert
# Orillo, ST PAULS Philippines) and the printed ORDO. For office use only and
# never to be committed: the repository carries the code, never the books.
server/data/orillo/
Needed info/

# Scratch scripts kept out of the repository.
server/tmp/

# Stray git directories kept beside the project (old history, backups).
# A .git directory committed *into* a repository is junk at best and a way to
# smuggle removed history back in at worst.
git(old)/
*.git/

# Downloaded while building the office installer.
desktop/.cache/

# The office installer in desktop/dist (matched by dist/ above) bundles the
# office's books and data, so it stays out. The public installer is committed:
# `npm run package:desktop:public` writes it, program only, to desktop/release/.
!desktop/release/

# The class template, kept locally while its pieces are merged in. It is not
# part of this project's source.
final-project-template-main/

# Coursework. This repository is public; the reports, journals and planning
# documents carry a name and a student number, so they live in the private
# workspace instead. The versions of these documents that belong in public are
# in docs/, written without any identity in them.
Docu/
docs/05-demo-video.md

# Tesseract's language model, downloaded on first use by the prayer-book
# importer. It is a ~15 MB binary blob that tesseract.js caches beside the
# process, it is not ours, and it is re-fetched whenever it is missing.
eng.traineddata
*.traineddata
docs/08-presentation-script.md

# The square image carries my name (the badge brief asks for it there).
# The copy that goes to Canvas lives in Docu/Week 3/.
docs/assets/square-1080.png
