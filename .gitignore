node_modules/
dist/
*.log
server/data/*.sqlite
server/data/*.sqlite-journal
server/data/*.sqlite-wal
server/data/*.sqlite-shm
server/.cache/
output/
.env
.DS_Store

# Copyrighted source material - transcriptions and scans of the office's own
# liturgical books (General Intercessions for Weekday Masses, Fr. Albert
# Orillo, ST PAULS Philippines) and the printed ORDO. For office use only and
# never to be committed: the repository carries the code, never the books.
server/data/orillo/
Needed info/

# Scratch scripts kept out of the repository.
server/tmp/

# Stray git directories kept beside the project (old history, backups).
# A .git directory committed *into* a repository is junk at best and a way to
# smuggle removed history back in at worst.
git(old)/
*.git/

# Downloaded while building the office installer.
desktop/.cache/

# The office installer in desktop/dist (matched by dist/ above) bundles the
# office's books and data, so it stays out. The public installer is committed:
# `npm run package:desktop:public` writes it, program only, to desktop/release/.
!desktop/release/
