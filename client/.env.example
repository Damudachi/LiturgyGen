# Copy to client/.env and fill in. client/.env is git-ignored.
#
# EVERYTHING HERE IS PUBLIC. Vite compiles each VITE_ variable into the built
# JavaScript, which anyone can download and read. Never put a secret in one -
# no service role key, no connection string, no password.

# Which backend the built client talks to.
#   false  -> the real Express API
#   unset or anything else -> the browser-only demo, on seeded sample data
# Demo mode is the DEFAULT on purpose: a forgotten variable then produces a
# visibly-labelled demo rather than a site that fails on every request.
VITE_USE_MOCK_API=false

# Empty when the client and the API share an origin, which is what `npm start`
# and the deployment do. Set it only for a client deployed apart from its API.
VITE_API_BASE_URL=

# Accounts. The PUBLISHABLE key is meant to be in the bundle - Row Level
# Security is what protects the data, not the secrecy of this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
