# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Every VITE_ value is compiled into the built JavaScript and is PUBLIC.
# Never put a key, a password or a connection string in here.

# Demo mode is the DEFAULT. Only the exact value "false" turns it off, so an
# unset or mistyped variable leaves you on the simulated backend with a visible
# notice, rather than on a silently broken build.
#
#   unset or true  = the browser answers its own requests from seed.json
#   false          = call the real API at VITE_API_BASE_URL
#
# The desktop packaging script sets this to false for the installer build.
VITE_USE_MOCK_API=true

# Where the Express API lives. Ignored while VITE_USE_MOCK_API is true.
#
# Leave it EMPTY when the client and the API share an origin, which is both the
# Vite dev server (it proxies /api to localhost:4000) and the desktop build
# (Express serves the built client itself).
#
# Set it only for a client deployed apart from its API, as on GitHub Pages:
#   https://your-api.onrender.com          <- no trailing slash
VITE_API_BASE_URL=
